[MAIN]
ignore-paths=.*__pycache__.*

[MESSAGES CONTROL]
disable=
    line-too-long,
    missing-function-docstring,
    too-many-locals,
    too-many-branches,
    import-outside-toplevel,
    wrong-import-position,
    multiple-imports,
    using-constant-test,
    broad-exception-caught,
    import-error

[FORMAT]
max-line-length=120
